<Window x:Name="MW" x:Class="MultipleRobloxInstances.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleRobloxInstances"
        mc:Ignorable="d"
        Title="MRI Pro Instance Manager" 
        Height="640" Width="960" 
        WindowStyle="None" 
        Background="{x:Null}" 
        AllowsTransparency="True"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown" 
        Foreground="{x:Null}">

    <Window.Resources>
        <!-- Sidebar Nav Item Style -->
        <Style x:Key="SidebarNavItemStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,9,16,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Terminate All Button Style -->
        <Style x:Key="SidebarTerminateAllStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Width="10" Height="10" Margin="0,0,6,0"
                                      VerticalAlignment="Center" Stretch="Uniform"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refresh Button Style -->
        <Style x:Key="RefreshButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushMonoFooter}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 C13.7,18 16.8,15.4 17.6,12 L15.4,12 C14.7,14.4 12.5,16 10,16 C6.7,16 4,13.3 4,10 C4,6.7 6.7,4 10,4 C11.9,4 13.6,4.9 14.7,6.3 L11.5,9.5 L18,9.5 L18,3 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="13" Height="13" Margin="0,0,7,0"
                                      VerticalAlignment="Center" Stretch="Uniform"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Styles -->
        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushIcon}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="wndBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wndBorder" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowControlButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="wndBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wndBorder" Property="Background" Value="{DynamicResource BrushErrorContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushError}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light Scrollbar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="{DynamicResource BrushBorderVariant}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Window Shell -->
    <Grid x:Name="Border" Loaded="Border_Loaded" Margin="8">
        <Border Background="{DynamicResource BrushShellBg}"
                BorderBrush="{DynamicResource BrushBorderVariant}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>

            <Grid x:Name="MainWin">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== SIDEBAR ==================== -->
                <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderOutline}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Branding -->
                        <StackPanel Grid.Row="0" Margin="16,24,16,32">
                            <TextBlock Text="MRI" FontFamily="Inter, Segoe UI" FontWeight="Bold"
                                       FontSize="32" Foreground="{DynamicResource BrushAccent}" LineHeight="40"/>
                            <TextBlock Text="Instance Manager" FontFamily="Inter, Segoe UI"
                                       FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="1" Margin="8,0,8,0">
                            <Button x:Name="InstancesTabBtn" Content="Active Sessions"
                                    Style="{StaticResource SidebarNavItemStyle}"
                                    Background="{DynamicResource BrushNavActiveBg}" Foreground="{DynamicResource BrushNavActiveText}"
                                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="4,0,0,0"
                                    Margin="0,0,0,8"
                                    Click="InstancesTabBtn_Click"/>
                            <Button x:Name="InstructionsTabBtn" Content="Setup Guide"
                                    Style="{StaticResource SidebarNavItemStyle}"
                                    Click="InstructionsTabBtn_Click"/>
                        </StackPanel>

                        <!-- Bottom Pinned: Terminate All -->
                        <Button x:Name="TerminateAllBtn" Grid.Row="2" Content="Terminate All"
                                Style="{StaticResource SidebarTerminateAllStyle}"
                                Margin="16,0,16,24"
                                Click="TerminateAllBtn_Click"/>
                    </Grid>
                </Border>

                <!-- ==================== CONTENT AREA ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Window Controls -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushShellBg}" BorderBrush="{DynamicResource BrushBorderVariant}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="Minimise" Style="{StaticResource WindowControlButtonStyle}" Margin="0,0,4,0" Click="Minimise_Click">
                                <Path Data="M4,7.5 L12,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="CloseWindow" Style="{StaticResource CloseWindowControlButtonStyle}" Click="Close_Click">
                                <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Main Viewport -->
                    <Grid Grid.Row="1" Margin="40,32,40,24">

                        <!-- VIEW A: ACTIVE SESSIONS -->
                        <Grid x:Name="InstancesView" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Page Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Active Sessions" FontFamily="Inter, Segoe UI" FontWeight="Bold"
                                               FontSize="32" Foreground="{DynamicResource BrushTextPrimary}" LineHeight="40"/>
                                    <Label x:Name="ActiveSessionsHeader" Content="0 Roblox instances currently running"
                                           Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI"
                                           FontSize="16" Padding="0" Margin="0,2,0,0"
                                           VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Header Actions: Refresh -->
                                <Button x:Name="RefreshBtn" Grid.Column="1" Content="Refresh"
                                        Style="{StaticResource RefreshButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="RefreshBtn_Click"/>
                            </Grid>

                            <!-- Empty State: Stepper Intro -->
                            <Border x:Name="EmptyStateGrid" Grid.Row="1" Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="16"
                                    Padding="28,24,28,24" Visibility="Visible">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrushPrimaryContainerBg}" Margin="0,0,10,0">
                                            <Path Data="M7,12.5 L10.5,16 L17,8.5" Stroke="{DynamicResource BrushAccent}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Ready for Multiple Roblox Accounts" FontFamily="Inter, Segoe UI"
                                                   FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Singleton mutex lock active. Launch game clients freely — sessions register automatically."
                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="14"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <!-- 3 Step Cards -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushPillBg}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="1" FontFamily="Inter, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,3"/>
                                                <TextBlock Text="Launch Account 1" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock Text="Open main browser and join any experience." FontFamily="Inter, Segoe UI" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushPillBg}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="2" FontFamily="Inter, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,3"/>
                                                <TextBlock Text="Launch Account 2" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock Text="Use Incognito or a 2nd browser profile." FontFamily="Inter, Segoe UI" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushPillBg}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="3" FontFamily="Inter, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,3"/>
                                                <TextBlock Text="Multi-Box Active" FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock Text="All sessions run concurrently here." FontFamily="Inter, Segoe UI" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Session List -->
                            <ScrollViewer x:Name="InstancesScrollView" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="WP1" HorizontalAlignment="Center" Width="640"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW B: SETUP GUIDE -->
                        <ScrollViewer x:Name="InstructionsView" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="672" HorizontalAlignment="Left" Margin="0,0,8,24">

                                <!-- Page Header -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock Text="Setup Guide" FontFamily="Inter, Segoe UI" FontWeight="Bold"
                                               FontSize="32" Foreground="{DynamicResource BrushTextPrimary}" LineHeight="40"/>
                                    <TextBlock Text="Follow these steps in order. Multiple Roblox Instances must be open before Roblox launches."
                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="16"
                                               TextWrapping="Wrap" MaxWidth="576" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Vertical Timeline Stepper -->
                                <!-- Step 1: Close all Roblox instances -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorderOutline}" BorderThickness="2">
                                            <TextBlock Text="1" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Inter, Segoe UI" FontSize="12"
                                                       FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="2" Height="40" Background="{DynamicResource BrushBorderVariant}" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,4,0,32">
                                        <TextBlock Text="Close All Roblox Instances" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                                                   FontSize="18" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Close every running Roblox instance first."
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="14" Margin="0,2,0,0"/>
                                        <TextBlock Text="Warning: Roblox may minimise itself to your tray. If so, click Exit on the Roblox tray icon."
                                                   Foreground="{DynamicResource BrushTextMuted}" FontFamily="Inter, Segoe UI" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Step 2: Run MRI first (important) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorderOutline}" BorderThickness="2">
                                            <TextBlock Text="2" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Inter, Segoe UI" FontSize="12"
                                                       FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="2" Height="40" Background="{DynamicResource BrushBorderVariant}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="12,0,0,32" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderVariant}"
                                            BorderThickness="1" CornerRadius="12">
                                        <Grid>
                                            <Border Width="4" HorizontalAlignment="Left" Background="{DynamicResource BrushAccent}" CornerRadius="12,0,0,12"/>
                                            <StackPanel Margin="24,20,24,20">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Run Multiple Roblox Instances" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                                                               FontSize="18" Foreground="{DynamicResource BrushAccent}"/>
                                                    <Border Margin="10,0,0,0" Padding="12,3,12,3" Background="{DynamicResource BrushPrimaryContainerBg}"
                                                            CornerRadius="9999" VerticalAlignment="Center">
                                                        <TextBlock Text="IMPORTANT" Foreground="{DynamicResource BrushPrimaryContainer}" FontFamily="Consolas, Segoe UI"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Start Multiple Roblox Instances now. It must be open BEFORE you launch Roblox."
                                                           Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Step 3: Launch account X -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorderOutline}" BorderThickness="2">
                                            <TextBlock Text="3" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Inter, Segoe UI" FontSize="12"
                                                       FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="2" Height="40" Background="{DynamicResource BrushBorderVariant}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,4,0,32">
                                        <TextBlock Text="Launch Account X (Main)" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                                                   FontSize="18" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Open https://www.roblox.com/home in your web browser and launch Roblox from your main account. Wait for Roblox to launch."
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Step 4: Launch account Y -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushBorderOutline}" BorderThickness="2">
                                            <TextBlock Text="4" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Inter, Segoe UI" FontSize="12"
                                                       FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                        <TextBlock Text="Launch Account Y (Alt)" FontFamily="Inter, Segoe UI" FontWeight="SemiBold"
                                                   FontSize="18" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Launch Roblox from your alt account in the browser. You must use a different Roblox account."
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderVariant}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="To switch accounts, you can:" Foreground="{DynamicResource BrushMonoFooter}" FontFamily="Inter, Segoe UI"
                                                           FontSize="14" FontWeight="Medium" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                          Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Log out and log into a different account (not recommended)"
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                          Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Use Roblox's account switcher"
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                          Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Use a different browser profile"
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                          Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Use a browser extension to switch accounts"
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                          Width="8" Height="8" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Anything else that allows you to launch from a different Roblox account"
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Inter, Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer Status Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0">
                        <Grid Margin="24,0,24,0">
                            <TextBlock Text="v2.2.0" Foreground="{DynamicResource BrushMonoFooter}" FontFamily="Consolas, Segoe UI"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="UpdateAvailable" Text="Update Available" Foreground="{DynamicResource BrushAccent}"
                                       FontFamily="Inter, Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,0,0"
                                       Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="MutexStatusText" Text="MUTEX: LOCKED" Foreground="{DynamicResource BrushMonoStatus}"
                                           FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock x:Name="CookieLockStatusText" Text="COOKIE ISOLATION: ACTIVE" Foreground="{DynamicResource BrushMonoStatus}"
                                           FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                <Button x:Name="ThemeToggleBtn" Click="ThemeToggleBtn_Click" ToolTip="Toggle Dark Mode"
                                        Width="26" Height="26" Margin="16,0,0,0" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="tb" Background="{TemplateBinding Background}" CornerRadius="13">
                                                <Path Data="M 12 2 A 10 10 0 1 0 22 12 A 7 7 0 1 1 12 2 Z"
                                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tb" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>