<UserControl x:Name="Username" x:Class="MultipleRobloxInstances.Resources.RobloxInstance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="640" Height="64" Margin="0,0,0,16">
    <UserControl.Resources>
        <!-- Close Session Icon Button Style -->
        <Style x:Key="CloseSessionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#585D60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Close Session"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <Path Data="M4,4 L10,10 M10,4 L4,10"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="14" Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FFDAD6"/>
                                <Setter Property="Foreground" Value="#BA1A1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FFC9C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Glass Panel Session Card -->
    <Border Background="#F7FFFFFF"
            BorderBrush="#F1F5F9"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F1F3FF"/>
                        <Setter Property="BorderBrush" Value="#DCE2F7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="UsernameGrid" Margin="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Left: Circular Avatar -->
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                    BorderBrush="#C7C4D7" BorderThickness="1" Background="#FFFFFF"
                    VerticalAlignment="Center" Margin="0,0,24,0" SnapsToDevicePixels="True">
                <Image x:Name="PFP" Width="46" Height="46" Source="/Resources/noFilter.png"
                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/>
                    </Image.Clip>
                </Image>
            </Border>

            <!-- 2. Center: Identity & Metadata -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Name Row: Display Name + Handle Chip -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label x:Name="DisplayName" Content="PlayerName"
                           Foreground="#141B2B" FontFamily="Inter, Segoe UI"
                           FontSize="18" FontWeight="SemiBold" Padding="0"
                           VerticalContentAlignment="Center"/>

                    <Border Margin="8,0,0,0" Padding="8,3,8,3" Background="#DCE2F7"
                            CornerRadius="8" VerticalAlignment="Center">
                        <Label x:Name="FullUsername" Content="@username"
                               Foreground="#464554" FontFamily="Consolas, Segoe UI"
                               FontSize="11" FontWeight="SemiBold" Padding="0"
                               VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Meta Row: Game Controller Icon + Game Name + Separator + PID -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                    <Path Data="M2,5 C2,3.9 2.9,3 4,3 L10,3 C11.1,3 12,3.9 12,5 L12,7.5 C12,8.9 10.9,10 9.5,10 L8.7,10 L7.8,8 L6.2,8 L5.3,10 L4.5,10 C3.1,10 2,8.9 2,7.5 Z M4,5.5 L6,5.5 M5,4.5 L5,6.5 M9.5,5.5 A0.4,0.4 0 1 1 9.5,5.51 M10.5,6.5 A0.4,0.4 0 1 1 10.5,6.51"
                          Fill="#767586" Width="13" Height="11" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Label x:Name="GameName" Content="Game Name"
                           Foreground="#464554" FontFamily="Inter, Segoe UI"
                           FontSize="14" Padding="0" VerticalContentAlignment="Center"/>

                    <Path Data="M0,0 L1,0 M0.5,-0.5 L0.5,0.5" Stroke="#C7C4D7" StrokeThickness="1"
                               Fill="#C7C4D7" Width="4" Height="4" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="10,0,10,0"/>

                    <Label x:Name="PidLabel" Content="PID --"
                           Foreground="#464554" FontFamily="Consolas, Segoe UI"
                           FontSize="11" FontWeight="SemiBold" Padding="0"
                           VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 3. Right: Status Pill + Close Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E9EDFF" BorderBrush="#DCE2F7" BorderThickness="1"
                        CornerRadius="9999" Padding="8,4,10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="StatusDotScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="4" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="StatusDotScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.95" To="1" Duration="0:0:1"/>
                                            <DoubleAnimation Storyboard.TargetName="StatusDotScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.95" To="1" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="Running" Foreground="#141B2B"
                                   FontFamily="Inter, Segoe UI" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <Button x:Name="KilInstance" Style="{StaticResource CloseSessionButtonStyle}"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>